@page "/customers"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using EpsilonWebApp.Application.DTOs
@using EpsilonWebApp.Client.Services
@using Microsoft.AspNetCore.Components
@inject CustomerApiService CustomerApiService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<MudProviders />

<MudContainer MaxWidth="MaxWidth.False" Class="mt-6 px-6">
    <MudPaper Class="pa-6 rounded-lg" Elevation="3">

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Customers</MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToCreateForm">
                Add Customer
            </MudButton>
        </MudStack>

        <MudTextField @bind-Value="searchCustomer" Placeholder="Search Customer" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mb-4" />

        @if (customers is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTable Items="filteredCustomers" Hover="true" Striped="true" Bordered="true" Dense="true" Elevation="0" RowsPerPage="3">
                <HeaderContent>
                    <MudTh>Company</MudTh>
                    <MudTh>Contact</MudTh>
                    <MudTh>City</MudTh>
                    <MudTh>Country</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Company">@context.CompanyName</MudTd>
                    <MudTd DataLabel="Contact">@context.ContactName</MudTd>
                    <MudTd DataLabel="City">@context.City</MudTd>
                    <MudTd DataLabel="Country">@context.Country</MudTd>
                    <MudTd DataLabel="Phone">@context.Phone</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => GoToEdit(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCustomer(context.Id))" />
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        }

    </MudPaper>
</MudContainer>

@code {
    private List<CustomerDto>? customers;
    private string searchCustomer = string.Empty;

    private IEnumerable<CustomerDto> filteredCustomers => string.IsNullOrWhiteSpace(searchCustomer) ? customers ?? [] : 
    (customers ?? []).Where(c => Contains(c.CompanyName) || Contains(c.ContactName) || Contains(c.City) || Contains(c.Country) || Contains(c.Phone));

    private bool Contains(string? value)
    {
        return !string.IsNullOrWhiteSpace(value) && value.Contains(searchCustomer, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerApiService.GetCustomersAsync();
    }

    private void GoToCreateForm()
    {
        NavigationManager.NavigateTo("/customers/create");
    }

    private void GoToEdit(Guid id)
    {
        NavigationManager.NavigateTo($"/customers/edit/{id}");
    }

    private async Task DeleteCustomer(Guid id)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(title: "Delete Customer",
        message: "Are you sure you want to delete this customer?",
        yesText: "Delete",
        cancelText: "Cancel");

        if (confirmed != true)
            return;

        await CustomerApiService.DeleteCustomerAsync(id);
        customers = await CustomerApiService.GetCustomersAsync();
    }
}